# Copy this file to .env and fill it in (or set these as real environment
# variables in Railway/your host — either works, real env vars win).

# Required for anti-tamper alerts. Discord → channel Settings → Integrations →
# Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK=

# Your Roblox User ID. Never auto-banned, but ONLY through /loader.lua with
# getgenv().SCORP_OWNER_KEY set — see OWNER_KEY below.
OWNER_USER_ID=

# A long random secret only you know. Before playing, run in your executor:
#   getgenv().SCORP_OWNER_KEY = "paste-the-same-value-here"
# Without this, OWNER_USER_ID gets the Owner nametag but is NOT exempt from bans.
OWNER_KEY=

# Protects every /api/admin/* route (Header: X-Admin-Key, or Authorization: Bearer).
# If you leave this blank the server invents one and prints it once at startup —
# copy it from the logs immediately, or just set your own here.
ADMIN_PASSWORD=

# Optional — sensible defaults are in src/server.js if you skip these.
# PORT=3000
# PUBLIC_URL=https://your-app.up.railway.app   # only needed if auto-detection is wrong
# DATA_DIR=./data
# AUTO_BAN=true
# AUTO_BAN_THRESHOLD=2
# BAN_SCORE=5
# TOKEN_TTL_HOURS=12
